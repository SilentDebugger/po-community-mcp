PO_ENV=local
PORT=5000
# Comma-separated list of public hostnames the MCP server should trust on the
# Host header. Required when deploying behind Sevalla / a custom domain so
# DNS-rebinding protection does not reject inbound requests.
# Example: ALLOWED_HOST=my-app.sevalla.app,mcp.example.com
ALLOWED_HOST=
LOG_LEVEL=info
